# Переменные окружения drawio-sql-er.
# Скопируйте в .env и поменяйте нужное:  cp .env.example .env
# .env не попадает в git. Все переменные необязательные — ниже значения по умолчанию.

# ---------------------------------------------------------------- Docker
# docker compose читает .env сам.

# Адрес, на котором открыт порт. 127.0.0.1 — только этот компьютер.
# 0.0.0.0 — вся сеть: только с прокси HTTPS и авторизацией впереди
# (пароль от базы передаётся в запросе к серверу).
SQL_ER_BIND=127.0.0.1

# Порт в браузере: http://localhost:8080
SQL_ER_PORT=8080

# Подключение к базе из окна плагина: on | off
# (off — останутся вставка SQL и файлы).
SQL_ER_DB=on

# ---------------------------------------------------------------- npm run serve
# Тот же сервер без Docker.

# Папка с файлами draw.io (webapp из github.com/jgraph/drawio). Обязательна для serve.
DRAWIO_DIR=

# Порт и адрес сервера.
PORT=8080
HOST=127.0.0.1

# ---------------------------------------------------------------- npm start
# draw.io Desktop + мост к базе.

# Путь к draw.io.exe, если он не в %LOCALAPPDATA%\Programs\draw.io или Program Files.
DRAWIO_EXE=

# Порт отладки Chromium, через который подгружается плагин (только 127.0.0.1).
DRAWIO_DEBUG_PORT=9339
